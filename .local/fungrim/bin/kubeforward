#!/bin/bash

[ -z "$1" ] && echo "Error: Missing pod name argument" && exit 1

PORTS="8080:8080"

if [ ! -z "$2" ]; then
    PORTS="$2"
fi

POD=$(kubectl get pods | grep -m 1 $1 | awk '{print $1}')

if [ -z "$POD" ]; then
    echo "Could not find pod by grepping string: $1"
    exit 1;
fi

kubectl port-forward pod/$POD $PORTS
