#!/bin/bash

[ -z "$1" ] && echo "Missing argument" && exit 1

if [ "-h" = "$1" ]; then
  echo "./switch-developer-context [personal | umbri | fungrim]"
  exit 0
fi

case $1 in 

	personal)
		git config --global user.email "contact@larsan.net"
		switch-ssh-profile personal
        gh auth login --with-token < ~/.gitauth/pat_personal.txt
        gh auth switch --user Fungrim
		gcloud config configurations activate personal > /dev/null 2>&1
		;;

	fungrim)
		git config --global user.email "lars@fungrim.com"
		switch-ssh-profile fungrim
        gh auth login --with-token < ~/.gitauth/pat_fungrim.txt
        gh auth switch --user vadslund
		gcloud config configurations activate fungrim > /dev/null 2>&1
		;;

	umbri)
	    git config --global user.email "lars@umbri.se"
	    switch-ssh-profile umbri
        gh auth login --with-token < ~/.gitauth/pat_personal.txt
        gh auth switch --user Fungrim
	    gcloud config configurations activate umbri > /dev/null 2>&1
	    ;;

	*)
		echo "Unknown profile: $1" && exit 1

esac
